# Copy to .env and edit. .env is gitignored; this file is not.
#
# Every setting in config/*.yaml can be overridden here using the NEUROTRADE_
# prefix, with a double underscore for nesting.

# Which profile to run: research | paper | live
NEUROTRADE_PROFILE=research

# Where the corpus lives. Point this at an external NVMe if the internal disk
# is tight — the bars corpus alone is 15-30 GB for 2k symbols over 5 years.
# NEUROTRADE_STORAGE__DATA_ROOT=/Volumes/nvme/neurotrade

# NEUROTRADE_LOG_LEVEL=DEBUG
