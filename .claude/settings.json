{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/work-context.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/work-checkpoint.sh" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "huggingface-skills@claude-plugins-official": false,
    "postman@claude-plugins-official": false
  }
}
